{
  "name": "@fermapp/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "prebuild": "prisma generate",
    "build": "tsup",
    "start": "node dist/server.js",
    "pretest": "prisma generate",
    "test": "vitest run",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "docs:api": "tsx scripts/generate-docs.ts",
    "local": "tsx --env-file=.env scripts/dev-local.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@fermapp/domain": "*",
    "@mapbox/shp-write": "^0.4.3",
    "@prisma/client": "6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tmcw/togeojson": "^7.1.2",
    "@xmldom/xmldom": "^0.9.8",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dejavu-fonts-ttf": "^2.37.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "mqtt": "^5.14.1",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2",
    "shpjs": "^6.1.0",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.6",
    "@types/pdfkit": "^0.17.3",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "embedded-postgres": "18.6.0-beta.19",
    "prisma": "6.19.3",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
