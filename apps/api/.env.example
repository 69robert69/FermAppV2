# Server
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:8081

# Bază de date și cache
DATABASE_URL=postgresql://fermapp:fermapp@localhost:5432/fermapp
# Opțional. Fără Redis, cache-ul rulează în memorie (doar pentru o singură instanță).
REDIS_URL=redis://localhost:6379

# Autentificare: generează cu `openssl rand -base64 48`
JWT_ACCESS_SECRET=schimba-acest-secret-cu-minimum-32-de-caractere
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# OpenWeatherMap (alerte). Fără cheie, alertele folosesc doar Open-Meteo.
OPENWEATHER_API_KEY=

# Sentinel-2: implicit Copernicus Data Space. Pentru Sentinel Hub comercial schimbă cele două URL-uri.
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
SENTINEL_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
SENTINEL_API_URL=https://sh.dataspace.copernicus.eu

# Asistent AI. Fără cheie, asistentul oferă un rezumat calculat din datele parcelei.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# IoT: opțional, pornește puntea MQTT
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=

# Notificări push: opțional, token de acces Expo
EXPO_ACCESS_TOKEN=

# Pune false pe instanțele care nu trebuie să ruleze joburile programate
JOBS_ENABLED=true
