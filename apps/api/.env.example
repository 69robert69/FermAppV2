# Server
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:8081

# Database and cache
DATABASE_URL=postgresql://fermapp:fermapp@localhost:5432/fermapp
# Optional. Without Redis, the cache runs in memory (single instance only).
REDIS_URL=redis://localhost:6379

# Authentication: generate with `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-this-secret-to-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# OpenWeatherMap (alerts). Without a key, alerts use only Open-Meteo.
OPENWEATHER_API_KEY=

# Sentinel-2: Copernicus Data Space by default. For commercial Sentinel Hub, change the two URLs.
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
SENTINEL_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
SENTINEL_API_URL=https://sh.dataspace.copernicus.eu

# AI assistant. Without a key, the assistant gives a summary calculated from the parcel data.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# IoT: optional, starts the MQTT bridge
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=

# Push notifications: optional, Expo access token
EXPO_ACCESS_TOKEN=

# Set to false on instances that must not run the scheduled jobs
JOBS_ENABLED=true
