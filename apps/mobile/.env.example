# The API address. On the Android emulator, the computer's localhost is 10.0.2.2.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Required for maps in Android and iOS builds
GOOGLE_MAPS_API_KEY=

# Required for push notifications (EAS project ID)
EAS_PROJECT_ID=

# The Firebase project key. Without it, the app uses the current server.
EXPO_PUBLIC_FIREBASE_API_KEY=

# Optional: Gemini wording for the Copilot (free tier from https://aistudio.google.com/apikey).
# Without it, the Copilot answers entirely on the phone. Farm data is sent to Google when set.
EXPO_PUBLIC_GEMINI_API_KEY=
# EXPO_PUBLIC_GEMINI_MODEL=gemini-3.5-flash-lite
