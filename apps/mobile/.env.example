# Adresa API-ului. Pe emulatorul Android, localhost-ul calculatorului este 10.0.2.2.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Necesar pentru hărți în build-urile Android și iOS
GOOGLE_MAPS_API_KEY=

# Necesar pentru notificări push (ID-ul proiectului EAS)
EAS_PROJECT_ID=

# Cheia proiectului Firebase. Fără ea, aplicația folosește serverul actual.
EXPO_PUBLIC_FIREBASE_API_KEY=
